yarn-error.log*
node_modules/
dist/
build/
.next/
.nuxt/
public/dist/
*.min.js
*.min.css

# Build outputs
*.exe
*.dll
*.so
*.a
*.out

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
